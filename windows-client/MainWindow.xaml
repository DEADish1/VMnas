<Window x:Class="VMnasAdmin.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="VMnas Admin" Height="820" Width="980" MinHeight="720" MinWidth="860" WindowStartupLocation="CenterScreen" Background="#090A0A" Foreground="#FFFFFF">
  <Window.Resources>
    <DrawingBrush x:Key="Panel" TileMode="Tile" Viewport="0,0,360,210" ViewportUnits="Absolute" Viewbox="0,0,360,210" ViewboxUnits="Absolute" Stretch="None">
      <DrawingBrush.Drawing><DrawingGroup>
        <GeometryDrawing Brush="#191619" Geometry="M0,0 H360 V210 H0 Z"/>
        <GeometryDrawing Brush="#241D21" Geometry="M0,22 L65,0 121,0 80,43 128,61 91,88 0,58 Z"/>
        <GeometryDrawing Brush="#311F27" Geometry="M188,0 L278,0 245,31 316,63 277,92 201,47 Z"/>
        <GeometryDrawing Brush="#251F23" Geometry="M300,118 L360,89 V210 H266 L294,163 232,142 262,109 Z"/>
        <GeometryDrawing Brush="#641E29" Geometry="M0,126 L48,101 96,120 67,142 118,173 77,197 0,173 Z"/>
        <GeometryDrawing Brush="#7E1F2A" Geometry="M147,91 L198,73 238,100 212,119 261,147 219,175 165,142 181,120 Z"/>
        <GeometryDrawing Brush="#3E2930" Geometry="M16,188 L62,160 111,180 89,210 H20 Z"/>
        <GeometryDrawing Brush="#423239" Geometry="M282,14 L310,0 332,0 298,42 343,59 360,82 360,111 312,82 329,55 286,38 Z"/>
        <GeometryDrawing Brush="#562A34" Geometry="M128,2 L147,2 116,51 102,46 Z"/>
        <GeometryDrawing Brush="#562A34" Geometry="M138,5 L157,5 126,55 112,50 Z"/>
        <GeometryDrawing Brush="#562A34" Geometry="M148,8 L167,8 136,58 122,53 Z"/>
        <GeometryDrawing Brush="#562A34" Geometry="M158,11 L177,11 146,61 132,56 Z"/>
      </DrawingGroup></DrawingBrush.Drawing>
    </DrawingBrush><SolidColorBrush x:Key="Accent" Color="#FF2020"/>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#111111"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="CaretBrush" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#745C66"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="9"/><Setter Property="FontSize" Value="14"/></Style>
    <Style TargetType="PasswordBox"><Setter Property="Background" Value="#111111"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="CaretBrush" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#745C66"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="9"/><Setter Property="FontSize" Value="14"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Background" Value="#111111"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#745C66"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8,6"/><Setter Property="FontSize" Value="14"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton x:Name="DropDownToggle" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False"><Grid><ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/><Path Data="M 0 0 L 8 0 L 4 5 Z" Fill="#FF4040" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/></Grid></ToggleButton><Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide"><Border Background="#171316" BorderBrush="#FF303A" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Background" Value="#1A1719"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="Padding" Value="8,6"/><Setter Property="FontSize" Value="14"/><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#4A1F27"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#AA1B25"/></Trigger></Style.Triggers></Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="#111111"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#745C66"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="9,6"/><Setter Property="FontSize" Value="14"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#3A2026"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#AA1B25"/></Trigger></Style.Triggers></Style>
    <Style TargetType="Button"><Setter Property="Background" Value="#2B2024"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#BE2732"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="4,0"/><Setter Property="FontWeight" Value="SemiBold"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#4A2028"/><Setter Property="BorderBrush" Value="#FF4040"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#8F1923"/></Trigger></Style.Triggers></Style>
    <Style TargetType="ProgressBar"><Setter Property="Background" Value="#0D0D0D"/><Setter Property="Foreground" Value="#FF2020"/><Setter Property="BorderBrush" Value="#745C66"/><Setter Property="BorderThickness" Value="1"/></Style>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid x:Name="LayoutGrid" Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel><StackPanel><TextBlock Text="VMNAS  /  INSTALLER STATION" FontSize="12" Foreground="#FFFFFF" FontWeight="Bold"/><TextBlock Text="Build your server USB" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="1. Choose the server image  •  2. Choose a USB drive  •  3. Create the installer" Foreground="#D6D0D3" Margin="0,5,0,0"/></StackPanel><Border DockPanel.Dock="Right" Background="#301C21" BorderBrush="#D92835" BorderThickness="1" CornerRadius="14" Padding="12,6"><TextBlock x:Name="StatusTextBlock" Text="Ready" Foreground="#FFFFFF"/></Border></DockPanel>
    <Expander Grid.Row="1" Header="Advanced: connect to a server and manage VMs" Foreground="#FFFFFF" Margin="0,16,0,0"><Border Background="{StaticResource Panel}" BorderBrush="#412C32" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,8,0,0"><StackPanel><TextBlock Text="SERVER CONNECTION" Foreground="#FFFFFF" FontWeight="Bold"/><TextBlock Text="Pair a VMnas server only if you want to manage its VMs from this PC." Foreground="#D6D0D3" Margin="0,4,0,0"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="SERVER ADDRESS" Foreground="#D6D0D3" FontSize="11"/><TextBlock Grid.Column="1" Text="PAIRING PIN" Foreground="#D6D0D3" FontSize="11" Margin="8,0,0,0"/><TextBox Grid.Row="1" x:Name="ServerUrlTextBox" Text="https://vmnas.local:8765"/><PasswordBox Grid.Row="1" Grid.Column="1" x:Name="PairingPinBox" Margin="8,0,0,0"/><Button Grid.Row="1" Grid.Column="2" Click="PairServer_Click">Connect</Button></Grid><TextBox x:Name="DeviceNameTextBox" Text="Windows Admin" Visibility="Collapsed"/><TextBlock x:Name="PairingStatusTextBlock" Foreground="#D6D0D3" Text="Enter the address and PIN shown by your VMnas server." Margin="0,8,0,0"/><Expander Header="VM management" Foreground="#FFFFFF" Margin="0,10,0,0"><StackPanel Margin="0,8,0,0"><Button HorizontalAlignment="Left" Click="RefreshServer_Click">Refresh server</Button><ListBox x:Name="VmListBox" DisplayMemberPath="DisplayName" Height="58" Margin="0,8,0,0"/><StackPanel Orientation="Horizontal" Margin="0,7,0,0"><Button Tag="start" Click="VmAction_Click">Start</Button><Button Tag="shutdown" Click="VmAction_Click">Shutdown</Button><Button Tag="stop" Click="VmAction_Click">Force stop</Button><Button Tag="reboot" Click="VmAction_Click">Reboot</Button><Button Click="DeleteVm_Click">Delete</Button></StackPanel></StackPanel></Expander></StackPanel></Border></Expander>
    <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="#412C32" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,12,0,0"><StackPanel><TextBlock Text="1  SERVER INSTALLER" Foreground="#FFFFFF" FontWeight="Bold"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="IsoPathTextBox" ToolTip="VMnas server ISO"/><Button Grid.Column="1" Click="BrowseIso_Click">Choose ISO</Button><Button Grid.Column="2" Click="BuildIso_Click">Build ISO</Button></Grid><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><ComboBox x:Name="CatalogComboBox" Width="310"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="#FFFFFF"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Click="OpenCatalogPage_Click">Official source</Button><Button Click="DownloadCatalogItem_Click">Download verified</Button></StackPanel></StackPanel></Border>
    <Border Grid.Row="3" Visibility="Collapsed" Background="{StaticResource Panel}" BorderBrush="#412C32" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,12,0,0"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="2  OPTIONAL GUEST MEDIA" Foreground="#FFFFFF" FontWeight="Bold"/><Button Grid.Column="1" Click="AddGuestMedia_Click">Add files</Button><Button Grid.Column="2" Click="RemoveGuestMedia_Click">Remove</Button></Grid><ListBox x:Name="GuestMediaListBox" Height="70" Margin="0,9,0,0"/></StackPanel></Border>
    <Border Grid.Row="4" Background="{StaticResource Panel}" BorderBrush="#412C32" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,12,0,0"><StackPanel><TextBlock Text="2  CHOOSE USB DRIVE" Foreground="#FFFFFF" FontWeight="Bold"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="DiskComboBox" SelectionChanged="DiskComboBox_SelectionChanged"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" Foreground="#FFFFFF"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Grid.Column="1" Click="RefreshDisks_Click">Refresh drives</Button></Grid><TextBlock x:Name="CapacityTextBlock" Foreground="#FFFFFF" Margin="0,10,0,0"/><ProgressBar x:Name="CapacityProgressBar" Height="14" Margin="0,7,0,0" Minimum="0" Maximum="100" Foreground="{StaticResource Accent}"/><TextBlock x:Name="WarningTextBlock" Foreground="#FFB4A8" Margin="0,8,0,0" TextWrapping="Wrap"/><StackPanel x:Name="WriteProgressPanel" Visibility="Collapsed" Margin="0,12,0,0"><TextBlock x:Name="WriteProgressTextBlock" Foreground="#FFFFFF" FontWeight="SemiBold"/><ProgressBar x:Name="WriteProgressBar" Height="18" Margin="0,6,0,0" Minimum="0" Maximum="100" Foreground="{StaticResource Accent}" IsIndeterminate="True"/></StackPanel></StackPanel></Border>
    <TextBox Grid.Row="5" x:Name="LogTextBox" Height="100" Margin="0,14,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#0B0B0B" Foreground="#FFFFFF" FontFamily="Consolas" Padding="12"/>
    <Button Grid.Row="6" x:Name="WriteButton" HorizontalAlignment="Right" Margin="0,18,0,0" Background="#D71D2A" Foreground="#FFFFFF" BorderBrush="#FF5A5A" FontWeight="Bold" Padding="22,11" Click="WriteUsb_Click">ERASE &amp; CREATE VMNAS USB</Button>
  </Grid></ScrollViewer>
</Window>
