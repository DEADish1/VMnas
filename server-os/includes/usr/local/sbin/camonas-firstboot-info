#!/usr/bin/env bash
set -euo pipefail

PAIRING_STORE="${CAMONAS_PAIRING_STORE:-/var/lib/camonas/pairing.json}"
PIN="not ready"
IP_ADDR="$(hostname -I 2>/dev/null | awk '{print $1}')"
INSTALL_PROFILE="/var/lib/camonas/install-profile.json"
ADMIN_USER="camonas"

if [[ -f "${INSTALL_PROFILE}" ]]; then
  ADMIN_USER="$(python3 - <<'PY'
import json
from pathlib import Path

path = Path("/var/lib/camonas/install-profile.json")
try:
    print(json.loads(path.read_text(encoding="utf-8")).get("admin_user", "camonas"))
except Exception:
    print("camonas")
PY
)"
fi

if [[ -f "${PAIRING_STORE}" ]]; then
  PIN="$(python3 - <<'PY'
import json
from pathlib import Path

path = Path("/var/lib/camonas/pairing.json")
print(json.loads(path.read_text(encoding="utf-8")).get("pin", "not ready"))
PY
)"
fi

if command -v pveum >/dev/null 2>&1; then
  for _ in $(seq 1 20); do
    if pveum user list >/dev/null 2>&1; then
      pveum user add root@pam 2>/dev/null || true
      pveum user add "${ADMIN_USER}@pam" 2>/dev/null || true
      pveum aclmod / -user root@pam -role Administrator 2>/dev/null || true
      pveum aclmod / -user "${ADMIN_USER}@pam" -role Administrator 2>/dev/null || true
      break
    fi
    sleep 3
  done
fi

cat > /etc/issue <<EOF
Camo NAS Server

Open Camo NAS Admin on your Mac.
Server address: ${IP_ADDR:-SERVER-IP}
Camo NAS control: https://${IP_ADDR:-SERVER-IP}:8765
Pairing PIN: ${PIN}

Advanced fallback: https://${IP_ADDR:-SERVER-IP}:8006

EOF
