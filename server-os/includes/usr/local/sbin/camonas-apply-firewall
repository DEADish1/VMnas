#!/usr/bin/env bash
set -euo pipefail

if ! command -v nft >/dev/null 2>&1; then
  echo "nft is not installed; skipping firewall setup." >&2
  exit 0
fi

cat > /etc/nftables.conf <<'EOF'
#!/usr/sbin/nft -f

flush ruleset

table inet camonas {
  chain input {
    type filter hook input priority 0;
    policy drop;

    iif "lo" accept
    ct state established,related accept
    ip protocol icmp accept
    ip6 nexthdr icmpv6 accept

    tcp dport { 22, 8006, 8765, 9091, 51413 } accept
    udp dport { 41641, 51820, 51413 } accept
    iifname "tailscale0" accept
    iifname "wg0" accept
  }

  chain forward {
    type filter hook forward priority 0;
    policy accept;
  }

  chain output {
    type filter hook output priority 0;
    policy accept;
  }
}
EOF

systemctl enable --now nftables
