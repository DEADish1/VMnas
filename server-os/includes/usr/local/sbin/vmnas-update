#!/usr/bin/env bash
set -euo pipefail
CONFIG=/etc/vmnas/update.conf
[[ -f "$CONFIG" ]] || exit 0
source "$CONFIG"
[[ -n "${VMNAS_UPDATE_MANIFEST_URL:-}" && -n "${VMNAS_UPDATE_PUBLIC_KEY:-}" ]] || exit 0
work="$(mktemp -d)"; trap 'rm -rf "$work"' EXIT
curl -fsSL "$VMNAS_UPDATE_MANIFEST_URL" -o "$work/manifest.json"
curl -fsSL "${VMNAS_UPDATE_MANIFEST_URL}.asc" -o "$work/manifest.json.asc"
gpgv --keyring "$VMNAS_UPDATE_PUBLIC_KEY" "$work/manifest.json.asc" "$work/manifest.json"
# Release tooling supplies a verified package URL and SHA-256 in the manifest.
